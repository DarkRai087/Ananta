# Copy this file to server/.env and fill in your Angel One SmartAPI details.
# server/.env is git-ignored. Never share it.

# From https://smartapi.angelone.in → My Apps → your app's "API Key"
SMARTAPI_API_KEY=

# Your Angel One client code (login ID), e.g. A1234567
SMARTAPI_CLIENT_CODE=

# Your 4-digit Angel One login PIN (MPIN)
SMARTAPI_PIN=

# The TOTP secret shown as text when you enable TOTP at https://smartapi.angelone.in/enable-totp
# (the same secret your authenticator app uses — not a 6-digit code)
SMARTAPI_TOTP_SECRET=

# Optional: force the intraday lab's data source (smartapi | yahoo).
# Default: smartapi when the four values above are set, or when this database already holds
# SmartAPI candles (they stay readable without the keys); otherwise yahoo.
# LAB_PROVIDER=

# Optional: server port (default 4000)
# PORT=4000
